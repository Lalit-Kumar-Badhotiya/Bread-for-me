# Copy this file to .env (gitignored) and fill to get Telegram pings.
# How to get the two values:
#   1. In Telegram, message @BotFather -> /newbot -> follow prompts ->
#      copy the HTTP API token it gives you.
#   2. IMPORTANT: open YOUR new bot in Telegram and send it any message
#      (press START). A bot can never message you first.
#   3. Message @userinfobot to get your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
